            "opening": {
                "description": "发送行为：开场语",
                "type": "object",
                "hint": "普通解析仅在存在可发送的富媒体时发送；归档命令会使用单独的打包文本。",
                "items": {
                    "enable": {
                        "description": "发送开场语",
                        "type": "bool",
                        "default": true
                    },
                    "content": {
                        "description": "开场语内容",
                        "type": "string",
                        "condition": {
                            "enable": true
                        },
                        "default": "流媒体解析bot为您服务 ٩( 'ω' )و"
                    },
                    "archive_content": {
                        "description": "打包自定义文本回复",
                        "type": "string",
                        "condition": {
                            "enable": true
                        },
                        "hint": "发送归档命令开始打包时发送；与普通解析共用上面的开场语开关。",
                        "default": "正在为您打包，请稍候..."
                    }
                }
            },
            "packing": {
                "description": "发送行为：消息聚合",
                "type": "object",
                "hint": "控制是否使用合并转发消息；ZIP 归档独立于此设置。NapCat 存在兼容问题，请按需启用。",
                "items": {
                    "mode": {
                        "description": "聚合模式",
                        "type": "string",
                        "options": [
                            "不聚合",
                            "全部聚合",
                            "按条件聚合"
                        ],
                        "default": "不聚合"
                    },
                    "zip_command": {
                        "description": "旧归档命令（自动迁移）",
                        "type": "string",
                        "default": "",
                        "invisible": true
                    },
                    "thresholds": {
                        "description": "按条件聚合阈值",
                        "type": "object",
                        "hint": "仅在选择“按条件聚合”时生效；0 = 不按该项触发。",
                        "condition": {
