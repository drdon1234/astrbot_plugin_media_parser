    "trigger": {
        "description": "触发设置",
        "type": "object",
        "items": {
            "auto_parse": {
                "description": "自动解析链接",
                "type": "bool",
                "default": true
            },
            "reply_trigger": {
                "description": "回复触发解析",
                "type": "bool",
                "hint": "引用含链接的消息并附关键词即可触发解析；与自动解析可同时开启。",
                "default": false
            },
            "keywords": {
                "description": "手动触发关键词",
                "type": "list",
                "hint": "自动解析关闭时用于普通消息；启用“回复触发解析”时也用于引用消息。消息包含任一关键词才触发；每项填写一个关键词。",
                "items": {
                    "type": "string"
                },
                "default": [
                    "视频解析",
                    "解析视频"
                ]
            }
        }
    },
    "parse_rate_limit": {
        "description": "解析频率限制",
        "type": "object",
        "hint": "最多解析次数填 0 表示不限制；启用限制时，时间窗必须大于 0。记录会持久化到插件运行时目录并自动裁剪。",
        "items": {
            "same_link": {
                "description": "同链接限制",
                "type": "object",
                "hint": "链接会先清洗为标准链接，过滤分享者、来源和追踪参数后再计数。",
                "items": {
                    "max_count": {
                        "description": "最多解析次数",
                        "type": "int",
                        "hint": "同一标准链接在时间窗内最多解析的次数；0 = 不限制",
                        "default": 0
                    },
                    "window_seconds": {
                        "description": "时间窗秒数",
                        "type": "int",
                        "hint": "必须大于 0；填 0 会关闭此限制。只统计该秒数内的记录，也用于自动裁剪持久化记录。",
                        "default": 3600
                    }
                }
            },
            "same_user": {
                "description": "同用户限制",
                "type": "object",
                "hint": "按消息发送者 ID 计数；一条消息内解析多个链接会分别计数。",
                "items": {
                    "max_count": {
                        "description": "最多解析次数",
                        "type": "int",
                        "hint": "同一用户在时间窗内最多解析的链接数；0 = 不限制",
                        "default": 0
                    },
                    "window_seconds": {
                        "description": "时间窗秒数",
                        "type": "int",
                        "hint": "必须大于 0；填 0 会关闭此限制。只统计该秒数内的记录，也用于自动裁剪持久化记录。",
                        "default": 3600
                    }
                }
            }
        }
    },
    "message": {
        "description": "消息输出",
        "type": "object",
        "hint": "按文本元数据、富媒体、附加内容和发送行为分区；字段开关只影响展示，不隐藏错误与媒体状态。",
        "items": {
            "text_metadata": {
                "description": "文本元数据",
                "type": "object",
                "hint": "分别控制解析摘要中的来源字段；关闭字段也不会影响解析、下载或错误提示。",
                "items": {
                    "show_title": {
                        "description": "显示标题",
                        "type": "bool",
                        "default": true
                    },
                    "show_author": {
                        "description": "显示作者",
                        "type": "bool",
                        "default": true
                    },
                    "show_timestamp": {
                        "description": "显示发布时间",
                        "type": "bool",
                        "default": true
                    },
                    "show_original_link": {
                        "description": "显示原始链接",
                        "type": "bool",
                        "hint": "关闭后不在解析结果中重复展示原链接。",
                        "default": true
                    },
                    "show_description": {
                        "description": "显示简介/正文",
                        "type": "bool",
                        "hint": "适合正文较长、只希望保留简短摘要的群聊。",
                        "default": true
                    },
                    "quote_user_message": {
                        "description": "引用用户消息",
                        "type": "bool",
                        "hint": "仅普通逐条发送时生效；聚合和 ZIP 不引用。只让文本元数据节点引用对应用户消息，媒体节点不引用。",
                        "default": false
                    },
                    "render_to_image": {
                        "description": "将文本元数据渲染为图片",
                        "type": "bool",
                        "hint": "开启后将基础文本、热评和翻译等所有文本节点合并渲染为一张图片发送；渲染失败时自动保留原文本发送。",
                        "default": false
                    },
                    "render_style": {
                        "description": "图片渲染风格",
                        "type": "string",
                        "condition": {
                            "render_to_image": true
                        },
                        "options": [
                            "清新便签",
                            "科技感",
                            "专业严肃",
                            "温和卡片"
                        ],
                        "default": "清新便签"
                    },
                    "render_font_family": {
                        "description": "图片字体",
                        "type": "string",
                        "condition": {
                            "render_to_image": true
                        },
                        "options": [
                            "默认黑体",
                            "专业宋体",
                            "清新文楷",
                            "标题手札",
                            "科技窄体"
                        ],
                        "hint": "默认字体缺失或校验失败时会从独立字体仓库自动补全；ASTRBOT_MEDIA_PARSER_FONT 指定的字体仍优先使用，字体补全不可用时渲染会回退原文本。",
                        "default": "默认黑体"
                    },
                    "render_font_size": {
                        "description": "图片字体大小",
                        "type": "int",
                        "condition": {
                            "render_to_image": true
                        },
                        "hint": "有效范围 16–42，数值越大图片越长。",
                        "default": 24
                    }
                }
            },
            "media_display": {
                "description": "富媒体展示",
                "type": "object",
                "items": {
                    "video_cover_only": {
                        "description": "视频仅发送封面",
                        "type": "bool",
                        "hint": "开启后不发送视频节点；每个视频会改为发送封面图片。解析结果有封面时直接使用封面，否则通过本地流式中继尝试截取视频第一帧；需要可用缓存目录和 ffmpeg，输入受下载大小硬限制。",
                        "default": false
                    },
                    "audio_send_mode": {
                        "description": "音频发送方式",
                        "type": "string",
                        "options": [
                            "语音",
                            "文件"
                        ],
                        "hint": "语音以聊天语音发送，格式转换可能需要 ffmpeg；文件保留原始音频。两种方式均单独发送，实际限制由聊天平台决定。",
                        "default": "语音"
                    }
                }
            },
            "hot_comments": {
                "description": "附加内容：热评",
                "type": "object",
                "hint": "仅对输出模式包含文本的支持平台生效；先将条数设为大于 0。优先热门或精选评论，没有此类排序时可展示普通评论或游戏评价。",
                "items": {
                    "count": {
                        "description": "热评条数",
                        "type": "int",
                        "hint": "填 0 不获取热评；大于 0 后按平台开关选择来源。实际数量受平台公开范围、分页和风控限制，可能少于设置值。",
                        "default": 0
